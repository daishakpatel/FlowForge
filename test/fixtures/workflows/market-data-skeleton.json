{
  "name": "market-data-skeleton", "timeout_seconds": 600, "on_failure": "fail",
  "concurrency": {"max_parallel_tasks": 4},
  "tasks": [
    {"id": "fetch", "type": "echo", "timeout_seconds": 60, "config": {"symbols": "${run.input.symbols}", "window_minutes": 5},
     "retry": {"max_attempts": 3, "strategy": "exponential", "initial_delay_ms": 500, "max_delay_ms": 5000, "multiplier": 2.0, "jitter": 0.2}},
    {"id": "normalize", "type": "sleep", "depends_on": ["fetch"], "timeout_seconds": 60, "config": {"duration_ms": 300}},
    {"id": "quality_check", "type": "echo", "depends_on": ["normalize"], "config": {"symbols": "${tasks.fetch.result.input.symbols}"}},
    {"id": "publish", "type": "echo", "depends_on": ["quality_check"], "config": {"checked": "${tasks.quality_check.status}"}},
    {"id": "alert", "type": "echo", "depends_on": ["quality_check"], "run_if": "on_failure", "config": {"failed": "${tasks.quality_check.status}"}}
  ]
}
