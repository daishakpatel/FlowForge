# FlowForge local environment: every variable in 00E §6, with dev-only defaults.
# Copy to .env for local overrides; never commit .env. Values match docker-compose.yml.
# Go services read these through internal/config (docs/configuration.md); a variable that is
# set but empty counts as unset. Precedence: struct defaults < FF_CONFIG_FILE < environment.
# internal/config/drift_test.go fails if a variable a service reads is missing here.
# Comments sit on their own lines because not every .env reader strips trailing "# ...".

# --- All services ---------------------------------------------------------------------------
# dev | test | prod (prod requires FF_ADMIN_BOOTSTRAP_KEY)
FF_ENV=dev
# debug | info | warn | error
FF_LOG_LEVEL=info
# json | text
FF_LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Optional YAML file: a flat map of these variable names to values (lists comma-separated).
# FF_CONFIG_FILE=./flowforge.yaml

# --- Databases ------------------------------------------------------------------------------
# api, scheduler
FF_PG_DSN=postgres://flowforge:flowforge@localhost:5432/flowforge?sslmode=disable
# processor, api (analytics read API)
FF_MD_PG_DSN=postgres://md:md@localhost:5433/marketdata?sslmode=disable

# Host ports for the Compose databases. Change them if 5432/5433 are taken on your machine
# (and adjust the DSNs above to match).
FF_DEV_PG_PORT=5432
FF_DEV_MD_PORT=5433

# --- flowforge-api ----------------------------------------------------------------------------
FF_API_HTTP_ADDR=:8080
FF_API_GRPC_ADDR=:9090
# Required when FF_ENV=prod; dev leaves it unset.
FF_ADMIN_BOOTSTRAP_KEY=
# true lets every request through as the dev admin (dev/test only; rejected when FF_ENV=prod).
# false (the default) requires an API key; in dev the first start prints a generated admin key.
FF_AUTH_DISABLED=true
# Requests per second per API key (burst 2x; worker and ai-readonly keys get 4x both).
FF_API_RATE_LIMIT_RPS=50

# --- Coordination (api, scheduler) -----------------------------------------------------------
FF_RAFT_ENDPOINTS=raft-1:7000,raft-2:7000,raft-3:7000

# --- flowforge-scheduler -----------------------------------------------------------------------
FF_SCHED_TICK=500ms
# FF_LEADER_RENEW must stay below half of FF_LEADER_TTL.
FF_LEADER_TTL=10s
FF_LEADER_RENEW=3s

# --- Workers (api, worker) --------------------------------------------------------------------
# FF_WORKER_HEARTBEAT must stay below half of FF_WORKER_LEASE_TTL.
FF_WORKER_LEASE_TTL=15s
FF_WORKER_HEARTBEAT=5s
# Per worker instance; no defaults in code, dev values shown.
FF_WORKER_ID=worker-1
FF_WORKER_QUEUES=default
FF_WORKER_CAPACITY=4
FF_API_GRPC_TARGET=localhost:9090
FF_WORKER_TOKEN=

# --- Kafka (scheduler outbox relay, worker, processor) ------------------------------------------
FF_KAFKA_BROKERS=localhost:9092

# --- AI service client (worker) ---------------------------------------------------------------
FF_AI_URL=http://ai-ops:8000
FF_AI_TOKEN=

# --- flowforge-raft node (per node; no defaults; example for node 1) --------------------------
# FF_RAFT_NODE_ID=1
# Entry format is defined by task 04.02.
# FF_RAFT_PEERS=
# FF_RAFT_DATA_DIR=/var/lib/flowforge/raft
# FF_RAFT_CLIENT_ADDR=:7000
# FF_RAFT_PEER_ADDR=:7001

# --- ai-ops (Python; task 06.01 owns these settings) -------------------------------------------
# AI_LLM_PROVIDER=mock
# AI_EMBED_PROVIDER=
# AI_FLOWFORGE_URL=
# AI_FLOWFORGE_TOKEN=
# AI_PROM_URL=
# AI_DB_URL=

# --- Integration tests (internal/testutil) ---------------------------------------------------
# Unset = start throwaway containers with testcontainers.
# Set to an admin DSN (URL form) to reuse running databases instead; each test still gets its own
# database, created and dropped by the helper.
# FF_TEST_PG_DSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# FF_TEST_MD_DSN=postgres://md:md@localhost:5433/postgres?sslmode=disable
# Set to make tests fail instead of skip when Docker is unavailable; CI sets it.
# FF_TEST_REQUIRE_DOCKER=1
