{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowforge.example/schemas/events/workflow_approval.v1.schema.json",
  "title": "Approval event payload, version 1",
  "description": "Payload of the approval.* events (internal/events.ApprovalPayload).",
  "type": "object",
  "required": [
    "approval_id",
    "run_id",
    "action_type",
    "risk",
    "status"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "risk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]*$"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "examples": [
    {
      "approval_id": "apr_01JCX0000000000000000000",
      "run_id": "run_01JCX0000000000000000000",
      "action_type": "retry_task",
      "risk": "low",
      "status": "PENDING"
    }
  ]
}
